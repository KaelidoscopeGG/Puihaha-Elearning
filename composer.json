{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "student/membership-tps",
  "type": "project",
  "description": "Membership Management and Transaction Processing System",
  "keywords": ["laravel", "membership", "tps"],
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "laravel/framework": "^12.0",
    "laravel/tinker": "^2.10"
  },
  "autoload": {
    "psr-4": { "App\\": "app/", "Database\\Factories\\": "database/factories/", "Database\\Seeders\\": "database/seeders/" }
  },
  "scripts": {
    "post-autoload-dump": ["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump", "@php artisan package:discover --ansi"],
    "post-update-cmd": ["@php artisan vendor:publish --tag=laravel-assets --ansi --force"],
    "setup": ["composer install", "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"", "@php artisan key:generate", "@php artisan migrate --seed"],
    "dev": ["php artisan serve"]
  },
  "extra": { "laravel": { "dont-discover": [] } },
  "config": { "optimize-autoloader": true, "preferred-install": "dist", "sort-packages": true, "allow-plugins": { "php-http/discovery": true } },
  "minimum-stability": "stable",
  "prefer-stable": true
}
